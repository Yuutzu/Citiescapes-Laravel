{
    "name": "citiescapes/apartment-rental",
    "type": "project",
    "description": "Citiescapes Apartment Rental Management System - CS12L Major Project",
    "keywords": ["laravel", "livewire", "rental", "apartment"],
    "license": "MIT",
    "require": {
        "php": "^8.4.12",
        "barryvdh/laravel-dompdf": "^3.0",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.4",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "@php artisan test",
        "test:bbt": "@php artisan test --testsuite=Feature",
        "test:wbt": "@php artisan test --testsuite=Unit",
        "test:ss1": "@php artisan test --filter=SS1",
        "test:ss2": "@php artisan test --filter=SS2",
        "test:ss3": "@php artisan test --filter=SS3",
        "test:ss4": "@php artisan test --filter=SS4",
        "test:ss5": "@php artisan test --filter=SS5",
        "test:ss6": "@php artisan test --filter=SS6"
    },
    "scripts-descriptions": {
        "test":     "Run the entire test suite (BBT + WBT)",
        "test:bbt": "Run all Black-Box tests (tests/Feature/*)",
        "test:wbt": "Run all White-Box tests (tests/Unit/*)",
        "test:ss1": "Run all SS1 tests (Public Listings & Inquiries)",
        "test:ss2": "Run all SS2 tests (Tenant Management)",
        "test:ss3": "Run all SS3 tests (Billing Management)",
        "test:ss4": "Run all SS4 tests (Contract Management)",
        "test:ss5": "Run all SS5 tests (Reports & Archives)",
        "test:ss6": "Run all SS6 tests (System Administration / Auth)"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
