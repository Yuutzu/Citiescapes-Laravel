APP_NAME="Citiescapes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://citiescapes.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=citiescapes
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ───────────────────────────────────────────────────────────────────────
# Mail — local default is 'log' (Laragon writes outbound mail to storage/logs).
# Production: use Hostinger's SMTP for the citiescapes2017@gmail.com mailbox.
# ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="citiescapes2017@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Hostinger production (Titan Email — comes bundled with hPanel domains) ──
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=citiescapes2017@gmail.com    # or the mailbox you create in hPanel
# MAIL_PASSWORD=                              # mailbox password from hPanel
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS="citiescapes2017@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"

# ── Gmail SMTP alternative (citiescapes2017@gmail.com with App Password) ──
# Requires 2-Step Verification on the Google account, then generate an App
# Password at https://myaccount.google.com/apppasswords — use it as MAIL_PASSWORD.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=citiescapes2017@gmail.com
# MAIL_PASSWORD=                              # 16-char Google App Password (no spaces)
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="citiescapes2017@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Citiescapes business config
CITIESCAPES_PENALTY_GRACE_DAYS=3
CITIESCAPES_PENALTY_DELINQUENT_DAY=14
CITIESCAPES_PENALTY_EVICTION_DAY=30
CITIESCAPES_LOCKOUT_THRESHOLD=5
CITIESCAPES_LOCKOUT_MINUTES=15
CITIESCAPES_OTP_EXPIRY_MINUTES=10
